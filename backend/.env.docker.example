APP_NAME=Ms.Hai RAG Client
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8100
LOG_LEVEL=INFO

# Origin nguoi dung truy cap. Production thay bang domain HTTPS that.
FRONTEND_ORIGIN=http://127.0.0.1:8100

# Dich vu chay tren may host cua Docker.
RAG_BASE_URL=http://host.docker.internal:8000
RAG_SEARCH_API_KEY=replace-with-rag-search-key
RAG_ADMIN_API_KEY=replace-with-rag-admin-key
RAG_TIMEOUT_SECONDS=45
RAG_IMAGE_TIMEOUT_SECONDS=120
RAG_TOP_K=10

PRODUCT_TIMEZONE_OFFSET=+07:00
PRODUCT_CHAT_PAGE_SIZE=10
PRODUCT_CANDIDATE_PAGE_SIZE=50
PRODUCT_IMAGE_MAX_BYTES=8388608

AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai

GEMINI_API_KEY=replace-with-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite

OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=90

# PostgreSQL tren may host. Neu cung Docker network, thay host bang ten service.
DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:5432/DATABASE_NAME
RAG_METADATA_SCHEMA=rag_metadata

# Tao bang: python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET_KEY=replace-with-random-secret-at-least-32-characters
AUTH_COOKIE_NAME=mshai_session
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_SECURE=false
