APP_NAME=RAG Client Backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8100
LOG_LEVEL=INFO

FRONTEND_ORIGIN=http://127.0.0.1:8100

RAG_BASE_URL=http://127.0.0.1:8000
RAG_SEARCH_API_KEY=replace-with-search-api-key
RAG_ADMIN_API_KEY=replace-with-admin-api-key
RAG_TIMEOUT_SECONDS=45
RAG_TOP_K=10

PRODUCT_TIMEZONE_OFFSET=+07:00
PRODUCT_CHAT_PAGE_SIZE=10
PRODUCT_CANDIDATE_PAGE_SIZE=50

# Tim san pham bang anh ngay trong backend client.
PRODUCT_IMAGE_SEARCH_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
PRODUCT_IMAGE_COLLECTION=bot_product_images_clip_v2
PRODUCT_CLIP_MODEL=ViT-B-32
PRODUCT_CLIP_PRETRAINED=laion2b_s34b_b79k
PRODUCT_CLIP_DEVICE=auto
PRODUCT_IMAGE_MAX_BYTES=8388608
PRODUCT_IMAGE_RESULT_LIMIT=8
PRODUCT_IMAGE_CANDIDATE_LIMIT=50
PRODUCT_IMAGE_MIN_SCORE=0.25

# Phan tich va kiem chung anh bang Gemini Vision.
# Giu false cho den khi pipeline Vision duoc ket noi hoan chinh.
PRODUCT_VISION_ENABLED=false
PRODUCT_VISION_MODEL=
PRODUCT_VISION_TIMEOUT_SECONDS=45
PRODUCT_VISION_VERIFY_TOP_K=5
PRODUCT_VISION_ORIGINAL_CANDIDATE_SLOTS=2
PRODUCT_VISUAL_VERIFICATION_ENABLED=false
PRODUCT_REFERENCE_IMAGE_TIMEOUT_SECONDS=15
PRODUCT_REFERENCE_IMAGE_MAX_BYTES=6291456

# Bo qua Gemini neu Top 1 cua Qdrant du cao va cach Top 2 du xa.
PRODUCT_IMAGE_FAST_ACCEPT_SCORE=0.88
PRODUCT_IMAGE_FAST_ACCEPT_MARGIN=0.08

# Nguong quyet dinh cuoi cung cua pipeline nhan dien.
PRODUCT_IMAGE_VECTOR_WEIGHT=0.55
PRODUCT_IMAGE_VISUAL_WEIGHT=0.45
PRODUCT_IMAGE_VERIFY_MIN_SCORE=0.65
PRODUCT_IMAGE_VISUAL_MIN_SCORE=0.50
PRODUCT_IMAGE_HIGH_CONFIDENCE=0.82
PRODUCT_IMAGE_MEDIUM_CONFIDENCE=0.65

# Provider AI chinh va provider du phong.
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai

GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

LLM_TIMEOUT_SECONDS=90
